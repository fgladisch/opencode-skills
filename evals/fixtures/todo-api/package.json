{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "Small in-memory todo REST API built with NestJS",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "lint:check": "eslint 'src/**/*.ts' 'test/**/*.ts' --max-warnings=0",
    "format": "prettier '**/*.{ts,js,mjs,md,json}' --write",
    "format:check": "prettier '**/*.{ts,js,mjs,md,json}' --check",
    "test": "jest",
    "verify": "pnpm run typecheck && pnpm run lint:check && pnpm run format:check && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.4",
    "@types/supertest": "6.0.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "prettier": "3.8.4",
    "supertest": "7.1.4",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
